{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "jsx": "preserve",
    "plugins": [],
    "incremental": false,
    "paths": {
      "@/*": ["../*"],
      "@payload-config": ["../payload.config.ts"],
      "@payload-types": ["../src/payload-types.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../collections/**/*.ts",
    "../lib/**/*.ts",
    "../payload.config.ts",
    "../src/payload-types.ts"
  ],
  "exclude": [
    "../node_modules",
    "../.next",
    "../app",
    "../components",
    "../scripts",
    "../collections/endpoints/**/*",
    "../tests"
  ]
}
