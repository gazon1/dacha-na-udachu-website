# ==============================================================================
# 🐳 DACHA PRODUCTION DOCKERFILE
# Build:  docker build -f Dockerfile.prod -t dacha .
# Run:    docker compose -f docker-compose.prod.yml up
#
# Note: Next.js frontend is built separately in the frontend service
# ==============================================================================

FROM python:3.12-slim-bookworm AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gettext \
    libpq5 \
    libpq-dev \
    gcc \
    libjpeg62-turbo \
    libjpeg-dev \
    zlib1g-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN groupadd --gid 1000 appgroup \
    && useradd --uid 1000 --gid 1000 --shell /bin/bash --home /workspace appuser \
    && chown -R appuser:appgroup /workspace

# Copy everything to /workspace/backend (matches build context ./backend)
COPY . /workspace/backend 

# Install Python deps
WORKDIR /workspace/backend
RUN uv sync --frozen --no-dev && chown -R appuser:appgroup /workspace/backend/.venv

RUN mkdir -p /workspace/.uv_cache

ENV PATH="/workspace/backend/.venv/bin:/usr/local/bin:$PATH"
ENV UV_CACHE_DIR=/workspace/.uv_cache
RUN chown -R appuser:appgroup /workspace
USER appuser

# NOTE: EXPOSE, entrypoint and CMD are in docker-compose.prod.yml
