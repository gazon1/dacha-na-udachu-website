# ==============================================================================
# 🐳 DACHA PRODUCTION DOCKERFILE
# Build:  docker build -f Dockerfile.prod -t dacha .
# Run:    docker compose -f docker-compose.prod.yml up
#
# Host-side management: just prod-* (/.just/dacha.just)
# Container CMD:        just prod-serve (runs gunicorn directly)
#
# Note: Next.js frontend is built separately in the frontend service
# ==============================================================================

FROM python:3.12-slim-bookworm AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gettext \
    libpq5 \
    libpq-dev \
    gcc \
    libjpeg62-turbo \
    libjpeg-dev \
    zlib1g-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists* \
    && curl -fsSL https://just.systems/install.sh | bash -s -- --to /usr/local/bin

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN groupadd --gid 1000 appgroup \
    && useradd --uid 1000 --gid 1000 --shell /bin/bash appuser \
    && mkdir -p /home/appuser && chown appuser:appgroup /home/appuser

# Copy everything
COPY . /workspace

# Install Python deps (from backend/ where pyproject.toml lives)
WORKDIR /workspace/backend
RUN uv sync --frozen --no-dev

WORKDIR /workspace

RUN mkdir -p /workspace/.uv_cache && chown -R appuser:appgroup /workspace

ENV PATH="/workspace/backend/.venv/bin:/usr/local/bin:$PATH"
ENV UV_CACHE_DIR=/workspace/.uv_cache
USER appuser

# NOTE: EXPOSE, entrypoint and CMD are in docker-compose.prod.yml
