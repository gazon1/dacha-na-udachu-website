# Build context exclusions for the Next.js + Payload image.
# Scoped to this project only — legacy rules for WebCrawler/Clojure/ASP.NET/
# Python projects were removed (none of those paths exist here, they made
# the real rules invisible).

# Git / CI
.git/
.gitattributes
.github/
.beads/

# Docker
.dockerignore
Dockerfile*
docker-compose*.yml
docker-compose*.yaml

# Dependencies — installed inside the image, must not come from the host
node_modules/
**/node_modules/
bot/node_modules/

# Build outputs — produced inside the image by `next build`
.next/
**/.next/
tsconfig.tsbuildinfo
vitest.config.ts

# Tests run in CI, not in the production container
tests/

# Secrets — must never enter the image.
# `.env` is gitignored so CI builds never see it, but `just docker-build` /
# `just local-up` run on a workstation that DOES have one; without these
# rules the secrets get baked into the image.
.env
.env.*
!.env.example

# Runtime uploads — must stay in a volume, never baked into the image
media/
**/media/

# Host-level / local-dev concerns
justfile          # local task runner
deploy/           # Caddy routing snippets, applied on the VPS
scripts/wait-healthy.sh  # deploy helper, run on the VPS or the laptop
*.log
logs/

# Editor / OS noise
.vscode/
.vs/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs
*.md
docs/