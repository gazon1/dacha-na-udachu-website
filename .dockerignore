docker-compose*.yaml

# Beads (issue tracking)
.beads/

# Logs
logs/
*.log

# Backup
Crawler.backup
*.backup

# Test results
TestResults/
coverage/

# Node
node_modules/
npm-debug.log*

# Project-specific — not part of the build context for the Next.js image
backend/         # Python (legacy Wagtail/Django)
media/           # Runtime uploads — should be a volume, not in image
tests/           # Test suite — not used by production build
# src/ is kept in the image so `payload migrate` can find src/migrations/
# at runtime. payload-types.ts is small and harmless to ship.
Caddyfile        # Reverse proxy config — host-level concern
justfile         # Local dev task runner
pytest.ini       # Python test config

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo

# Documentation
README.md
docs/
*.md

