FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Runtime зависимости: libjpeg-dev zlib1g-dev — для Pillow/Pillow-simd
# libpq-dev — для psycopg (бинарный wheel)
# gettext — для django management commands (i18n)
# curl — для healthcheck
# gcc — для компиляции C-расширений если нет wheel
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gettext \
    libpq-dev \
    gcc \
    libjpeg-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# just — runtime launcher
RUN curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh | bash -s -- --to /usr/local/bin

# uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /workspace

# Зависимости
COPY pyproject.toml uv.lock* /workspace/
RUN uv pip install --system --only-binary :all: -r pyproject.toml || \
    uv pip install --system -r pyproject.toml

# Код
COPY . /workspace/
RUN chmod +x /workspace/Justfile /workspace/justfile 2>/dev/null || true

EXPOSE 8000

CMD ["just", "entrypoint"]
