# ==============================================================================
# 🐳 DACHA PRODUCTION DOCKERFILE
# Build:  docker build -f Dockerfile.prod -t dacha .
# Run:    docker compose -f docker-compose.prod.yml up
#
# Host-side management: just prod-* (/.just/dacha.just)
# Container CMD:        just prod-serve (runs gunicorn directly)
# ==============================================================================

FROM python:3.12-slim-bookworm AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# Build args for Next.js (passed via --build-arg from docker-compose or CLI)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WAGTAIL_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_TELEGRAM_BOT_USERNAME

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gettext \
    libpq5 \
    libpq-dev \
    gcc \
    libjpeg62-turbo \
    libjpeg-dev \
    zlib1g-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists* \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists* \
    && curl -fsSL https://just.systems/install.sh | bash -s -- --to /usr/local/bin

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN groupadd --gid 1000 appgroup \
    && useradd --uid 1000 --gid 1000 --shell /bin/bash appuser \
    && mkdir -p /home/appuser && chown appuser:appgroup /home/appuser

# Copy everything (node_modules, .venv, .next excluded via .dockerignore)
COPY . /workspace

# Install Python deps (from dacha/ where pyproject.toml lives)
WORKDIR /workspace/dacha
RUN uv sync --frozen --no-dev

# Build frontend
WORKDIR /workspace/dacha/web
RUN echo "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}" >> .env.local && \
    echo "NEXT_PUBLIC_WAGTAIL_API_URL=${NEXT_PUBLIC_WAGTAIL_API_URL}" >> .env.local && \
    echo "NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}" >> .env.local && \
    echo "NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=${NEXT_PUBLIC_TELEGRAM_BOT_USERNAME}" >> .env.local
RUN npm ci && npm run build

WORKDIR /workspace

RUN mkdir -p /workspace/.uv_cache && chown -R appuser:appgroup /workspace

ENV PATH="/workspace/dacha/.venv/bin:/usr/local/bin:$PATH"
ENV UV_CACHE_DIR=/workspace/.uv_cache
USER appuser

# NOTE: EXPOSE, entrypoint and CMD are in docker-compose.prod.yml
