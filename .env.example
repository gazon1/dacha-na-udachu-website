# ============================================================================
#  Dacha — полный шаблон окружения
#
#  КАК ПОЛЬЗОВАТЬСЯ
#    cp .env.example .env   и заполните значения.
#
#  СЕКЦИИ БЫВАЮТ ДВУХ ТИПОВ:
#    • [ЗАПОЛНИТЬ]  — значение необходимо подставить своё. Оставлено пустым,
#                     чтобы случайно не уехать с чужой заглушкой.
#    • [ТЕХНИЧЕСКИЕ] — значение задаётся самим приложением/Docker-сетью.
#                     Обычно править не нужно; менять только если переносите
#                     сайт на другой домен или порт.
#
#  ПУСТОЕ ЗНАЧЕНИЕ = «не задано». Это не то же самое, что дефолт из кода:
#  например SMTP_* пустые → почта просто не настроена, всё остальное работает.
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
#  РUNTIME / DOCKER  [ТЕХНИЧЕСКИЕ]
# ────────────────────────────────────────────────────────────────────────────
# Порт Next.js внутри контейнера. Должен совпадать с target в
# deploy/caddy.conf.caddy и со значением ${PORT} в docker-compose.yml.
PORT=3000

# production обязателен для Docker. В локальной разработке ставьте development
# (npm run dev), иначе бот уйдёт в webhook-режим вместо long-polling.
NODE_ENV=production

# Payload доверяет заголовкам прокси (X-Forwarded-Proto от Caddy). Без этого
# Secure-флаг у cookie и CSRF-проверки ломаются за HTTPS. Держите 1.
TRUST_HOST=1


# ────────────────────────────────────────────────────────────────────────────
#  PAYLOAD CMS
# ────────────────────────────────────────────────────────────────────────────

# [ЗАПОЛНИТЬ] Подпись сессий Payload. Длинная случайная строка.
#   openssl rand -hex 32
PAYLOAD_SECRET=

# [ЗАПОЛНИТЬ] Канонический публичный адрес сайта (без слеша в конце).
# Используется как serverURL, CORS и CSRF — от него зависят cookie за
# вход в админку. ВАЖНО: CSRF проверяет Origin, поэтому неверное значение
# ломает вход в /admin.
PAYLOAD_PUBLIC_SERVER_URL=

# [НЕОБЯЗАТЕЛЬНО] GraphQL выключен, пока эта переменная не равна "true".
# В коде GraphQL не используется ни разу (админка Payload и все страницы ходят
# через REST/Local API), а включённый эндпоинт вместе с playground отдаёт
# наружу всю схему — список коллекций, полей и связей. Ставьте "true" только
# для локальной отладки GraphQL-запросов.
# GRAPHQL_ENABLED=true

# Тот же адрес для sitemap.xml, robots.txt и OpenGraph-тегов. Next.js
# инлайнит в клиентский бандл только переменные с префиксом NEXT_PUBLIC_,
# поэтому имя продублировано намеренно. Значение ДОЛЖНО совпадать с
# PAYLOAD_PUBLIC_SERVER_URL; lib/site-url.ts упадёт при расхождении.
# Пустое значение не опасно — подставится прод-домен, а не localhost.
NEXT_PUBLIC_SERVER_URL=


# ────────────────────────────────────────────────────────────────────────────
#  БАЗА ДАННЫХ
# ────────────────────────────────────────────────────────────────────────────

# [ЗАПОЛНИТЬ] Строка подключения к PostgreSQL.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Используется и приложением, и ботом, и сервисом бэкапа перед миграцией.
DATABASE_URI=


# ────────────────────────────────────────────────────────────────────────────
#  TELEGRAM — ЛОГИН ЧЕРЕЗ САЙТ
# ────────────────────────────────────────────────────────────────────────────

# [ЗАПОЛНИТЬ] Токен бота от @BotFather. Секрет, только на сервере.
#   ВАЖНО: этот токен попадает в клиентский бандл только через
#   NEXT_PUBLIC_TELEGRAM_BOT_NAME; сам TELEGRAM_BOT_TOKEN остаётся на сервере.
TELEGRAM_BOT_TOKEN=

# [ЗАПОЛНИТЬ] Имя бота без @. Это публичное значение — оно специально
# попадает в браузер, поэтому здесь секрета быть не может.
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# Получателей админских уведомлений НЕ задают переменной окружения:
# список и их подписки по категориям живут в CMS → Настройки сайта →
# telegramAdmins (telegramId + notifyOn). Здесь только выдаётся сам токен.


# ────────────────────────────────────────────────────────────────────────────
#  TELEGRAM — БОТ (сервис bot в docker-compose)
# ────────────────────────────────────────────────────────────────────────────

# [ТЕХНИЧЕСКИЕ] Публичный HTTPS-адрес, на который Telegram шлёт апдейты.
# Caddy проксирует jellyfin.maxdrobin.ru → bot:3001/webhook. Нужен A-record.
WEBHOOK_URL=https://jellyfin.maxdrobin.ru/webhook

# [ЗАПОЛНИТЬ] ОБЯЗАТЕЛЬНО, если задан WEBHOOK_URL и NODE_ENV=production —
# без него бот не стартует. Telegram возвращает это значение в заголовке
# X-Telegram-Bot-Api-Secret-Token в каждом апдейте, бот отклоняет всё
# несовпадающее. Без него любой желающий, зная публичный /webhook, отправил бы
# поддельный апдейт и выдал себя за админа.
# Ограничения Telegram: 1–256 символов, только A-Z a-z 0-9 _ и -.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# [ТЕХНИЧЕСКИЕ] Порт HTTP-сервера бота. Совпадает с target в
# deploy/caddy.conf.caddy.
BOT_PORT=3001

# [ЗАПОЛНИТЬ] Общий секрет для app → bot. Эндпоинт
# POST /internal/broadcast-event проверяет заголовок x-internal-secret.
# Пусто → бот отвечает 503 broadcast_disabled (рассылки отключены).
#   openssl rand -hex 32
INTERNAL_API_SECRET=

# [ТЕХНИЧЕСКИЕ] Внутренние адреса между сервисами Docker-сети. Меняйте,
# только если переименовали сервисы в docker-compose.yml.
TELEGRAM_BOT_INTERNAL_URL=http://bot:3001/internal/broadcast-event
APP_INTERNAL_URL=http://app:3000

# [НЕОБЯЗАТЕЛЬНО] SOCKS5-прокси только для запросов к api.telegram.org —
# помогает, где Bot API недоступен. Postgres и внутренние вызовы
# НЕ проксируются. Формат: socks5://[user:pass@]host:port
TELEGRAM_SOCKS5_PROXY=


# ────────────────────────────────────────────────────────────────────────────
#  YOOMONEY — взносы на события
# ────────────────────────────────────────────────────────────────────────────

# [ЗАПОЛНИТЬ] Регистрация приложения: https://yoomoney.ru/oauth/app/new
YOOMONEY_CLIENT_ID=
YOOMONEY_CLIENT_SECRET=

# [ЗАПОЛНИТЬ] Redirect URI должен совпадать с адресом в настройках приложения:
#   https://<ваш-домен>/api/event-contributions/yoomoney-callback
YOOMONEY_REDIRECT_URI=

# [ЗАПОЛНИТЬ] Номер кошелька получателя, например 41001XXXXXXXX.
YOOMONEY_WALLET=

# [ЗАПОЛНИТЬ] Секрет HTTP-уведомлений. Тот же ключ вставить в
# настройках кошелька → HTTP notifications. По нему проверяется HMAC-подпись
# вебхука, поэтому подделка платежа невозможна.
#   openssl rand -hex 32
YOOMONEY_NOTIFICATION_SECRET=

# [ЗАПОЛНИТЬ] Токен доступа. Получается один раз на странице
# /api/event-contributions/yoomoney-auth: подписать кошелёк, скопировать
# значение, вставить сюда и перезапустить приложение.
YOOMONEY_ACCESS_TOKEN=

# [ЗАПОЛНИТЬ] Общий секрет для эндпоинта /check-payments. Его вызывает
# GitHub Actions (cron) каждые 15 минут. Значение обязано посимвольно
# совпадать с переменной CRON_SECRET в настройках репозитория GitHub
# (Settings → Secrets and variables → Actions → Secrets).
# Пусто → эндпоинт отвечает 503 и сверка платежей не идёт.
#   openssl rand -hex 32
CRON_SECRET=


# ────────────────────────────────────────────────────────────────────────────
#  ПОЧТА  [НЕОБЯЗАТЕЛЬНО]
# ────────────────────────────────────────────────────────────────────────────
# Заполняйте целиком или не заполняйте ничего: SMTP_HOST управляет
# регистрацией почтового адаптера в payload.config.ts. Частично заполненная
# группа приведёт к ошибкам при отправке.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=


# ────────────────────────────────────────────────────────────────────────────
#  SEED  [НЕОБЯЗАТЕЛЬНО]
# ────────────────────────────────────────────────────────────────────────────
# `payload seed` запускается на КАЖДОМ деплое как блокирующий шаг
# (docker-compose: backup → migrate → seed → app). Контент (допуслуги, FAQ,
# тестовый дом) создаётся всегда; админ — только если заполнены ОБЕ
# переменные ниже.
#
# Рекомендация для продакшена: оставьте обе пустыми. Seed запишет
# предупреждение и пропустит админа, первого админа заведите через
# интерфейс /admin. Половина заполненных переменных — ошибка.
#   openssl rand -base64 12   (минимум 8 символов)
PAYLOAD_SEED_ADMIN_EMAIL=
PAYLOAD_SEED_ADMIN_PASSWORD=


# ────────────────────────────────────────────────────────────────────────────
#  Шпаргалка: что чем генерировать
# ────────────────────────────────────────────────────────────────────────────
#   PAYLOAD_SECRET ................ openssl rand -hex 32
#   TELEGRAM_WEBHOOK_SECRET ....... openssl rand -hex 32
#   INTERNAL_API_SECRET .......... openssl rand -hex 32
#   YOOMONEY_NOTIFICATION_SECRET . openssl rand -hex 32
#   CRON_SECRET ................... openssl rand -hex 32
#   PAYLOAD_SEED_ADMIN_PASSWORD ... openssl rand -base64 12
#
#   YOOMONEY_ACCESS_TOKEN ........ через /yoomoney-auth в браузере
