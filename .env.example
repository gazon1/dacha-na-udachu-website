# ===========================================
# Telegram Login Widget
# ===========================================
# Bot token from @BotFather (server-side, keep secret)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bot username without @ (client-side, public)
NEXT_PUBLIC_TELEGRAM_BOT_NAME=your_bot_username

# Chat ID (numeric) where admin notifications go — e.g. -1001234567890 for a group,
# or a positive int for a private chat. Leave empty to disable admin notifications.
# Get it: message the bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy chat.id from the response.
TELEGRAM_ADMIN_CHAT_ID=

# ===========================================
# Payload CMS
# ===========================================
PAYLOAD_SECRET=change-me-in-production-use-long-random-string

# Canonical public site URL. Used by Payload (serverURL, CORS, CSRF) AND,
# via NEXT_PUBLIC_SERVER_URL below, by sitemap/robots/OG metadata.
# Keep these two in sync — see the note under NEXT_PUBLIC_SERVER_URL.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Public site URL for SEO artefacts (sitemap.xml, robots.txt, OpenGraph).
# Falls back to https://dacha.maxdrobin.ru if unset, so a missing value here
# never silently points SEO at http://localhost:3000.
# NOTE: this duplicates PAYLOAD_PUBLIC_SERVER_URL by design — Next.js only
# inlines env vars prefixed with NEXT_PUBLIC_ into the client/edge bundle,
# so the value cannot be shared under a single name. Change BOTH together.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ===========================================
# Database
# ===========================================
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/dacha

# ===========================================
# Seed (optional admin account)
# ===========================================
# `payload seed` runs on EVERY deploy as a blocking step (docker-compose.yml).
# Content (extra-services, FAQ, sample house) is always seeded; the admin
# user is created ONLY when BOTH variables below are set.
# Leave both empty on production: the seed will log a warning and skip the
# admin. Create the first admin through the Payload admin UI instead.
# If you DO set them, both must be set — a half-configured pair is an error.
# PAYLOAD_SEED_ADMIN_EMAIL=admin@example.com
# PAYLOAD_SEED_ADMIN_PASSWORD=change-me-min-8-chars

# ===========================================
# Email (optional - only if SMTP_HOST is set)
# ===========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=Dacha CMS

# ===========================================
# YooMoney (voluntary contributions widget)
# ===========================================
# Register an app at https://yoomoney.ru/oauth/app/new to get client_id.
# Set Redirect URI to: https://<your-domain>/api/event-contributions/yoomoney-callback
# Enable "Verify app authenticity" to also receive client_secret.
YOOMONEY_CLIENT_ID=
YOOMONEY_CLIENT_SECRET=
YOOMONEY_REDIRECT_URI=https://your-domain.example/api/event-contributions/yoomoney-callback
YOOMONEY_WALLET=41001XXXXXXXX

# Notification secret — generate a random string, set the same value in
# YooMoney wallet settings → HTTP notifications. Used to verify webhook HMAC.
YOOMONEY_NOTIFICATION_SECRET=

# Access token obtained via the OAuth flow at /yoomoney-auth.
# Run that page once after registration, copy the token, paste below, restart server.
YOOMONEY_ACCESS_TOKEN=

# Shared secret for the /check-payments cron endpoint (used by external scheduler).
CRON_SECRET=

# ===========================================
# Telegram Bot (webhook service in docker-compose)
# ===========================================
# Public URL where Telegram sends updates. Must be reachable via HTTPS.
# Caddy proxies jellyfin.maxdrobin.ru → bot:3001/webhook. Requires a DNS A-record.
WEBHOOK_URL=https://jellyfin.maxdrobin.ru/webhook

# Port for the bot's HTTP server (webhook + internal broadcast + healthcheck).
# Default 3001. Must match Caddyfile reverse_proxy target.
BOT_PORT=3001

# Shared secret for app → bot internal HTTP broadcast. The bot exposes
# POST /internal/broadcast-event; this secret gates it.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# Internal URL the main app uses to call the bot. Inside Docker this
# is the bot service hostname. The app reads this to fire broadcasts.
TELEGRAM_BOT_INTERNAL_URL=http://bot:3001/internal/broadcast-event

# Internal URL the bot uses to call the main app's /api/event-contributions/submit.
# Inside Docker — app service hostname.
APP_INTERNAL_URL=http://app:3000

# SOCKS5 proxy for outgoing requests to api.telegram.org.
# Leave empty to use direct connection. Format: socks5://[user:pass@]host:port
# Used to bypass Telegram blocks in regions where Bot API is unreachable.
# Other HTTP traffic (Postgres, internal broadcast) is NOT proxied.
# TELEGRAM_SOCKS5_PROXY=socks5://user:pass@127.0.0.1:1080
