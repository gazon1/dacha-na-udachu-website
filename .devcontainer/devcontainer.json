{
  "name": "Django CMS Dev",
  "dockerComposeFile": [
    "compose.yml"
  ],
  "service": "web",
  "remoteUser": "max",
  "workspaceFolder": "/workspace",
  // Установка зависимостей Python после создания
  // Используем system, так как uv в Dockerfile ставил пакеты глобально
  "postCreateCommand": "just init",
  // "postCreateCommand": "uv sync --extra dev",
  // Эта команда выполняется каждый раз при старте контейнера.
  // Гарантируем, что зависимости на месте, даже если вы их удалили.
  "postStartCommand": "just activate-python-env",
  "customizations": {
    "vscode": {
      // --- РАСШИРЕНИЯ (Объединенный список) ---
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "astral-sh.ruff",
        "ms-python.mypy-type-checker",
        "batisteo.vscode-django",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker",
        "IronGeek.vscode-env",
        "donjayamanne.git-extension-pack",
        "redhat.vscode-yaml",
        "njpwerner.autodocstring",
        "ms-vscode.makefile-tools",
        "usernamehw.errorlens",
        "nefrob.vscode-just-syntax",
        "yy0931.vscode-sqlite3-editor",
        "dbcode.dbcode",
        "arniu.sql-formatter-vscode",
        "fogio.jetbrains-file-icon-theme",
        "miguelsolorio.fluent-icons",
        "PKief.material-icon-theme",
        "zhuangtongfa.material-theme",
        "gitpocalypse.angeldoc-vscode",
        "Anthropic.claude-code",
        "matthewpi.caddyfile-support"
      ],
      "settings": {
        // --- PYTHON & ИНТЕРПРЕТАТОР ---
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        // --- RUFF (Линтер/Форматтер) ---
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        // Путь к ruff (системный, так как ставили глобально)
        "ruff.path": [
          "/workspace/.venv/bin/ruff"
        ],
        "ruff.configuration": "/workspace/pyproject.toml",
        "ruff.trace.server": "verbose",
        // --- MYPY ---
        "mypy-type-checker.args": [
          "--config-file=/workspace/pyproject.toml"
        ],
        "mypy-type-checker.interpreter": [
          "/workspace/.venv/bin/python"
        ],
        // --- TERMINAL (Zsh & Fonts) ---
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.fontFamily": "MesloLGS NF, 'Droid Sans Mono', 'monospace', monospace",
        // --- ПРОЧЕЕ ---
        "makefile.configureOnOpen": false,
      }
    }
  }
}