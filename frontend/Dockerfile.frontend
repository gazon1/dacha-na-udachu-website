# ==============================================================================
# 🐳 Next.js Frontend Production Dockerfile
# Context: ./frontend
# ==============================================================================

FROM node:22-alpine AS base

WORKDIR /app

# Copy package files first for dependency caching
COPY package*.json ./
COPY package-lock.json* ./

RUN npm ci --ignore-scripts

# Copy source code
COPY next.config.ts ./
COPY proxy.ts ./
COPY healthcheck.js ./
COPY tsconfig.json ./
COPY tailwind.config.* ./
COPY postcss.config.mjs ./
COPY ./app ./app
COPY ./components ./components
COPY ./hooks ./hooks
COPY ./lib ./lib
COPY ./public ./public
COPY ./stores ./stores
COPY ./src ./src

# Build-time args:
#   BACKEND_URL      — server-only (not NEXT_PUBLIC_*), used by next.config.ts rewrites.
#   NEXT_PUBLIC_*    — browser-baked into the client bundle.
ARG BACKEND_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_TELEGRAM_BOT_USERNAME

# BACKEND_URL is server-only — only needed as process.env during build, not in client bundle.
ENV BACKEND_URL=${BACKEND_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=${NEXT_PUBLIC_TELEGRAM_BOT_USERNAME}

RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
