{
    email drobin.me@yandex.ru
    admin localhost:2019
    log default {
        output stdout
        format json
        level INFO
    }
}

# Single domain — Payload admin and Next.js frontend share one origin
# (same process). Everything routes to app:3000.
dacha.maxdrobin.ru {
    encode gzip zstd
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}